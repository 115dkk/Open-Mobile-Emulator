#
# Pinned inputs of the self-built guest image (P3, docs/P3-PLAN.md). Every value here is what
# build-image.sh consumes. Change a value deliberately and say why in the commit message; the
# per-project commit snapshot lives next to this file in manifest/ome.xml once the first sync
# has run (build-image.sh snapshot).

# Which profile this build produces (manifests/images/<profile>.json).
OME_GUEST_PROFILE=ome-android-15

# BlissOS 18 (Android 15) tree. voyager-x86 default.xml tracks android-15.0.0_r14; the branch
# HEAD was pinned on 2026-10-01 (docs/evidence/P3/research-bliss-build.md).
BLISS_MANIFEST_URL=https://github.com/BlissOS/platform_manifest.git
BLISS_MANIFEST_BRANCH=voyager-x86
BLISS_MANIFEST_COMMIT=db973c9fec45d90f4b85de56c6711e0227716e69

# Build target. Voyager uses the three-part lunch name.
BLISS_LUNCH=bliss_x86_64-ap4a-userdebug
BLISS_BUILD_VARIANT=vanilla

# Blob-free build (CLAUDE.md R3). Bliss adds the native bridges and Google apps through these
# variables regardless of BLISS_BUILD_VARIANT, so build-image.sh unsets every one of them and
# refuses to build if one is set in the environment.
OME_BLOB_FLAGS="USE_LIBNDK_TRANSLATION_NB USE_CROS_HOUDINI_NB ANDROID_USE_NDK_TRANSLATION ANDROID_USE_INTEL_HOUDINI USE_EMU_GAPPS USE_OPENGAPPS"

# Installer environment assets. bootable/aaropa/download.sh fetches releases/latest without a
# pin or a checksum, so build-image.sh downloads this release tag itself and checks the files
# against aaropa.sha256 (recorded on the first run, then committed).
AAROPA_ROOTFS_RELEASE=r101
AAROPA_ROOTFS_FILES="install.sfs initrd_lib.tar.gz grub-rescue.iso boot_hybrid.img"

# Shallow history keeps the source tree near 100 GB instead of 170 GB. The commit snapshot still
# pins every project.
OME_REPO_DEPTH=1

# Build host: Ubuntu 22.04 LTS. The WSL rootfs is what New-BuildDistro.ps1 imports; the
# Dockerfile uses the same release from the ubuntu:22.04 image.
BUILD_HOST_ROOTFS_URL=https://cloud-images.ubuntu.com/wsl/jammy/current/ubuntu-jammy-wsl-amd64-ubuntu22.04lts.rootfs.tar.gz
BUILD_HOST_ROOTFS_SHA256=1483cc5c1dce13064f774834cbffdff226559fd522a67a381a8ea77d63fb4109
REPO_LAUNCHER_URL=https://storage.googleapis.com/git-repo-downloads/repo
