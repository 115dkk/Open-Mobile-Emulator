#
# Every fixed value of the phone CI (ci/selfhosted/README.md). setup-phone.sh, the bridge, the
# runner gate and ome-ci all read this file; change a value here and run setup-phone.sh again.

# Who may run what. The runner's job-started hook (job-started.sh) accepts a job only when all of
# these match.
OME_CI_REPO=115dkk/Open-Mobile-Emulator
OME_CI_BRANCH=selfhosted/guest-build
OME_CI_WORKFLOW=.github/workflows/guest-build-selfhosted.yml
OME_CI_OWNER=115dkk

# Runner labels. Control stages (status, stop) go to their own runner so they answer while a
# build job holds the main one for days.
OME_CI_LABEL_MAIN=ome-guest-build
OME_CI_LABEL_CTL=ome-guest-build-ctl

# Containers (proot-distro). The build container is the guest/build host recipe (Ubuntu 22.04,
# x86_64, run through qemu-user); the runner container is native arm64. Image index digests as of
# 2026-11-15 (both last updated 2026-11-12).
OME_CI_BUILD_CONTAINER=ome-build
OME_CI_BUILD_IMAGE=ubuntu:22.04@sha256:74b12b11ffa550fba1929ad4d8d16533c34f6612728469671afba1b03b66881c
OME_CI_RUNNER_CONTAINER=ome-runner
OME_CI_RUNNER_IMAGE=ubuntu:24.04@sha256:2198e4c65076e9cb0b3d695219df667c0e3b0072da64ca3c2648aca17dcecaf5

# GitHub Actions runner for linux-arm64 (checksum from the release notes). The runner updates
# itself afterwards when GitHub asks it to; this pin is only the first install.
OME_CI_RUNNER_VERSION=2.338.2
OME_CI_RUNNER_SHA256=670adb2f268fe21dcbb58b3db0e0aa9d5b3bddfe2c651481336e561ff86de945

# Build settings handed to guest/build/build-image.sh (README "Low memory"). 8 GB leaves the
# rest of the phone's 15 GB to Android; sync keeps the job count GitHub tolerated on 2026-10-01.
OME_CI_MEM_BUDGET_GB=8
OME_CI_BUILD_JOBS=2
OME_CI_SYNC_JOBS=6
OME_CI_TREE=/home/ome/bliss
