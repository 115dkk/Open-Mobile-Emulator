# SPDX-License-Identifier: GPL-2.0-or-later
# Copyright (C) 2026 Open Mobile Emulator contributors
# Verified 2026-09-25: https://www.qemu.org/download/#source
# Tag and commit: https://gitlab.com/qemu-project/qemu/-/tags
QEMU_GIT_URL=https://gitlab.com/qemu-project/qemu.git
QEMU_TAG=v11.1.1
QEMU_COMMIT=c3d48b7d1e89604920e5b81b91140c2ad39a1943
# https://www.msys2.org/docs/terminals/
MSYS2_ENV=UCRT64
MSYS2_ROOT=/c/msys64
# https://raw.githubusercontent.com/msys2/MINGW-packages/refs/heads/master/mingw-w64-qemu/PKGBUILD
QEMU_TARGETS=x86_64-softmmu
# Each exact package name was checked at these URLs.
# https://packages.msys2.org/package/base-devel
# https://packages.msys2.org/package/git
# https://packages.msys2.org/package/bzip2
# https://packages.msys2.org/package/mingw-w64-ucrt-x86_64-gcc
# https://packages.msys2.org/package/mingw-w64-ucrt-x86_64-python
# https://packages.msys2.org/package/mingw-w64-ucrt-x86_64-python-setuptools
# https://packages.msys2.org/package/mingw-w64-ucrt-x86_64-python-pip
# https://packages.msys2.org/package/mingw-w64-ucrt-x86_64-python-wheel
# python-pip and python-wheel: QEMU 11 configure installs the [tooling] group of
# pythondeps.toml (qemu.qmp from the vendored wheel, setuptools, wheel, pip) into an
# offline venv because of --disable-download; without them configure fails with
# "Could not find a version that satisfies the requirement wheel>=0.34.2". The MSYS2
# QEMU PKGBUILD lists both in makedepends (2026-09-25 build log, this repo).
# https://packages.msys2.org/package/mingw-w64-ucrt-x86_64-meson
# https://packages.msys2.org/package/mingw-w64-ucrt-x86_64-ninja
# https://packages.msys2.org/package/mingw-w64-ucrt-x86_64-pkgconf
# https://packages.msys2.org/package/mingw-w64-ucrt-x86_64-glib2
# https://packages.msys2.org/package/mingw-w64-ucrt-x86_64-pixman
# https://packages.msys2.org/package/mingw-w64-ucrt-x86_64-zlib
# https://packages.msys2.org/package/mingw-w64-ucrt-x86_64-libepoxy
# https://packages.msys2.org/package/mingw-w64-ucrt-x86_64-virglrenderer
# https://packages.msys2.org/package/mingw-w64-ucrt-x86_64-SDL2
# https://packages.msys2.org/package/mingw-w64-ucrt-x86_64-libslirp
MSYS2_PACKAGES='base-devel git bzip2 mingw-w64-ucrt-x86_64-gcc mingw-w64-ucrt-x86_64-python mingw-w64-ucrt-x86_64-python-setuptools mingw-w64-ucrt-x86_64-python-pip mingw-w64-ucrt-x86_64-python-wheel mingw-w64-ucrt-x86_64-meson mingw-w64-ucrt-x86_64-ninja mingw-w64-ucrt-x86_64-pkgconf mingw-w64-ucrt-x86_64-glib2 mingw-w64-ucrt-x86_64-pixman mingw-w64-ucrt-x86_64-zlib mingw-w64-ucrt-x86_64-libepoxy mingw-w64-ucrt-x86_64-virglrenderer mingw-w64-ucrt-x86_64-SDL2 mingw-w64-ucrt-x86_64-libslirp'
# virglrenderer ships for UCRT64; no unreviewed source-build fallback.
# Package versions are recorded, not frozen, in out/pacman-lock.txt at build time.
