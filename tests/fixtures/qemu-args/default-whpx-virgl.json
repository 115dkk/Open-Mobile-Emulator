{
  "input": {
    "mode": "boot",
    "name": "default",
    "disk": "C:\\vm\\disk.qcow2",
    "firmware_code": "C:\\fw\\code.fd",
    "firmware_vars": "C:\\vm\\efivars.fd",
    "iso": null,
    "gpu": "virgl",
    "accel": "whpx",
    "cpu_model": "Skylake-Client-v4",
    "memory_mib": 8192,
    "vcpus": 4,
    "qmp_port": 4444,
    "adb_port": 5555,
    "audio": "dsound",
    "display": "sdl",
    "extra_args": null
  },
  "args": [
    "-name",
    "OME default",
    "-machine",
    "q35",
    "-accel",
    "whpx,kernel-irqchip=off",
    "-cpu",
    "Skylake-Client-v4",
    "-m",
    "8192",
    "-smp",
    "4",
    "-drive",
    "if=pflash,format=raw,readonly=on,file=C:\\fw\\code.fd",
    "-drive",
    "if=pflash,format=raw,file=C:\\vm\\efivars.fd",
    "-drive",
    "file=C:\\vm\\disk.qcow2,if=virtio,format=qcow2",
    "-device",
    "virtio-vga-gl,edid=off",
    "-display",
    "sdl,show-cursor=on,gl=on",
    "-device",
    "virtio-net-pci,netdev=n0",
    "-netdev",
    "user,id=n0,hostfwd=tcp:127.0.0.1:5555-:5555",
    "-usb",
    "-device",
    "usb-tablet",
    "-device",
    "usb-kbd",
    "-audiodev",
    "dsound,id=snd0",
    "-device",
    "intel-hda",
    "-device",
    "hda-duplex,audiodev=snd0",
    "-qmp",
    "tcp:127.0.0.1:4444,server=on,wait=off",
    "-action",
    "reboot=shutdown",
    "-rtc",
    "base=utc",
    "-serial",
    "none",
    "-parallel",
    "none"
  ]
}
