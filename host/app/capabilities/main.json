{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The webview may call only this app's typed commands and listen to its snapshot and progress events. No core:default, no plugin permissions, no remote content (docs/adr/0003-webview-capability.md).",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-app-snapshot",
    "allow-host-check-refresh",
    "allow-wizard-continue",
    "allow-wizard-skip",
    "allow-wizard-defer",
    "allow-open-help",
    "allow-app-quit",
    "allow-whpx-enable",
    "allow-artifact-download-start",
    "allow-artifact-download-cancel",
    "allow-guest-image-select",
    "allow-guest-create",
    "allow-guest-select",
    "allow-guest-delete",
    "allow-guest-reinstall",
    "allow-guest-start",
    "allow-guest-stop",
    "allow-guest-restart",
    "allow-guest-root-set",
    "allow-guest-volume-set",
    "allow-stage-rect-changed",
    "allow-screenshot-save",
    "allow-app-install-pick",
    "allow-app-install-cancel",
    "allow-app-uninstall",
    "allow-app-launch",
    "allow-input-profile-select",
    "allow-input-suspend-toggle",
    "allow-input-overlay-toggle",
    "allow-input-profile-delete",
    "allow-input-profile-save",
    "allow-input-binding-upsert",
    "allow-input-binding-remove",
    "allow-input-editor-toggle",
    "allow-input-auto-apply-set",
    "allow-input-suspend-hotkey-set",
    "allow-display-preset-apply",
    "allow-display-custom-apply",
    "allow-display-refresh-set",
    "allow-display-vsync-set",
    "allow-stage-fit-set",
    "allow-settings-save",
    "allow-update-check",
    "allow-update-install",
    "allow-diagnostics-export",
    "allow-open-logs-folder",
    "allow-open-screenshots-folder",
    "allow-open-home-folder",
    "allow-copy-to-clipboard",
    "allow-open-registration-page",
    "allow-guest-window-to-front"
  ]
}
