# OME unattended install helper (ADR-0010 spike).
#
# Sourced by the Bliss initrd /init after it has mounted the ISO at /mnt, mounted the
# ISO's system image at /android and linked /system to it. Runs only when the kernel
# command line carries OME_INSTALL=1, and always ends in poweroff, so the helper boot
# never reaches Android. Progress goes to the serial port as "OME-INSTALL ..." lines.
#
# Kernel command line variables (the kernel exports unknown KEY=VALUE pairs to init):
#   OME_INSTALL=1      run this helper
#   OME_DISK=/dev/vda  target disk (default /dev/vda)
#   OME_SRC=ome        folder on the new partition that holds kernel, initrd.img,
#                      system.img and data/ (default ome); the installed guest boots with
#                      -append "root=/dev/ram0 SRC=/<OME_SRC> ..."
#

[ "$OME_INSTALL" = "1" ] || return 0

ome_disk=${OME_DISK:-/dev/vda}
ome_dir=${OME_SRC:-ome}
ome_part=${ome_disk}1
ome_tty=/dev/ttyS0

exec >$ome_tty 2>&1

ome_say()
{
	echo "OME-INSTALL $*"
}

ome_off()
{
	sync
	poweroff -f
	sleep 5
	echo o > /proc/sysrq-trigger
	sleep 30
}

ome_fail()
{
	ome_say "fail $*"
	ome_off
	exit 1
}

# Replaces one file inside the copied system.img with debugfs from install.sfs, without mounting
# the image: ome_img_put <path in image> <staged name in /hd/$ome_dir> <octal mode> <label file
# name in /hd/$ome_dir> <failure tag>. /hd must be bound at /install/mnt. The image is mounted
# read-only at run time, so init's restorecon cannot label a file written here; the label is
# written with the file. debugfs exits 0 even when a request fails, so the result is read back.
ome_img_put()
{
	ome_img=/mnt/$ome_dir/system.img
	ome_name=${1##*/}
	ome_tool /usr/sbin/debugfs -w -f - $ome_img > /dev/null 2>&1 <<-EOF
	cd ${1%/*}/
	rm $ome_name
	write /mnt/$ome_dir/$2 $ome_name
	set_inode_field $1 mode 0100$3
	set_inode_field $1 uid 0
	set_inode_field $1 gid 0
	ea_set -f /mnt/$ome_dir/$4 $1 security.selinux
	EOF
	ome_tool /usr/sbin/debugfs -R "stat $1" $ome_img 2>/dev/null | grep -q "Type: regular" || ome_fail $5-write
	ome_tool /bin/sh -c "/usr/sbin/debugfs -R 'ea_get -f /mnt/$ome_dir/.ome-label-check $1 security.selinux' $ome_img > /dev/null 2>&1 && cmp -s /mnt/$ome_dir/.ome-label-check /mnt/$ome_dir/$4" || ome_fail $5-xattr
	ome_tool /bin/sh -c "/usr/sbin/debugfs -R 'cat $1' $ome_img 2>/dev/null | cmp -s - /mnt/$ome_dir/$2" || ome_fail $5-verify
	rm -f /hd/$ome_dir/.ome-label-check
}

# Profiles with adb_secure (the Android 15 image) get the host key and adb switched on.
# The system image's /adb_keys is a symlink to /product/etc/security/adb_keys, which does not
# exist; the helper replaces it with a regular file carrying the /adb_keys label of
# plat_file_contexts. The image is a user-type build that ships with adb off
# (persist.sys.usb.config absent, so the first boot stores none); the helper adds
# persist.sys.usb.config=adb to /system/build.prop, which init.usb.rc copies to sys.usb.config on
# boot and AdbService reads to initialise adb_enabled. The prop keeps the file's own mode and label.
ome_adb_keys()
{
	[ -s /ome/adb_keys ] || return 0
	ome_say "step keys 91"
	if [ "$ome_env" = aaropa ]; then
		mount --bind /hd /install/mnt || ome_fail keys-bind
		cp /ome/adb_keys /hd/$ome_dir/.adb_keys || ome_fail keys-copy
		printf 'u:object_r:system_file:s0\000' > /hd/$ome_dir/.adb_keys.label || ome_fail keys-label
		ome_img_put /adb_keys .adb_keys 644 .adb_keys.label keys
		ome_say "keys $(wc -l < /ome/adb_keys)"

		ome_tool /bin/sh -c "/usr/sbin/debugfs -R 'cat /system/build.prop' /mnt/$ome_dir/system.img 2>/dev/null > /mnt/$ome_dir/.build.prop" || ome_fail prop-read
		ome_tool /bin/grep -q '^ro.build.version.sdk=' /mnt/$ome_dir/.build.prop || ome_fail prop-read
		if ome_tool /bin/grep -qx 'persist.sys.usb.config=adb' /mnt/$ome_dir/.build.prop; then
			ome_say "adb already on"
		else
			ome_tool /bin/sh -c "/usr/sbin/debugfs -R 'ea_get -f /mnt/$ome_dir/.build.prop.label /system/build.prop security.selinux' /mnt/$ome_dir/system.img > /dev/null 2>&1" || ome_fail prop-label
			[ -s /hd/$ome_dir/.build.prop.label ] || ome_fail prop-label
			ome_mode=$(ome_tool /usr/sbin/debugfs -R "stat /system/build.prop" /mnt/$ome_dir/system.img 2>/dev/null | sed -n 's/.*Mode: *0*\([0-7]\{3\}\) .*/\1/p')
			[ -n "$ome_mode" ] || ome_fail prop-mode
			ome_tool /bin/sed -i '/^persist\.sys\.usb\.config=/d' /mnt/$ome_dir/.build.prop || ome_fail prop-edit
			echo 'persist.sys.usb.config=adb' >> /hd/$ome_dir/.build.prop || ome_fail prop-edit
			ome_img_put /system/build.prop .build.prop $ome_mode .build.prop.label prop
			ome_say "adb on mode=$ome_mode"
		fi
		rm -f /hd/$ome_dir/.adb_keys /hd/$ome_dir/.adb_keys.label /hd/$ome_dir/.build.prop /hd/$ome_dir/.build.prop.label
		umount /install/mnt || ome_fail keys-unbind
		return 0
	fi
	mkdir -p /omesys || ome_fail keys-mkdir
	mount -t ext4 -o loop,rw /hd/$ome_dir/system.img /omesys || ome_fail keys-mount
	rm -f /omesys/adb_keys
	cp /ome/adb_keys /omesys/adb_keys || ome_fail keys-copy
	chown 0:0 /omesys/adb_keys && chmod 644 /omesys/adb_keys || ome_fail keys-mode
	sync
	umount /omesys || ome_fail keys-umount
	ome_say "keys $(wc -l < /ome/adb_keys)"
}

cd / || ome_fail cd
ome_say "start disk=$ome_disk dir=$ome_dir kernel=$(uname -r)"
ome_say "efi=$(cat /sys/firmware/efi/fw_platform_size 2>/dev/null)"

if [ -f /src/install.img ]; then
	ome_env=legacy
elif [ -f /mnt/$SRC/install.sfs ] && [ -f /mnt/$SRC/system.efs ]; then
	ome_env=aaropa
else
	ome_fail "unknown initrd"
fi
ome_say "env $ome_env"

if [ "$ome_env" = legacy ]; then
# 1. tools: sgdisk, pv and their libraries live in install.img (the initrd removed the
#    busybox fdisk and mke2fs on purpose; mke2fs comes from the Android system image).
ome_say "step tools 1"
[ -f /src/install.img ] || ome_fail "no install.img"
zcat /src/install.img | ( cd /; cpio -iud > /dev/null 2>&1 ) || ome_fail tools
ome_mkfs=/system/bin/mke2fs
[ -x $ome_mkfs ] || ome_mkfs=$(command -v mkfs.ext4)
ome_say "tools sgdisk=$(command -v sgdisk) pv=$(command -v pv) mke2fs=$ome_mkfs mkfs.ext3=$(command -v mkfs.ext3) mkfs.ext4=$(command -v mkfs.ext4) rsync=$(command -v rsync)"
[ -n "$ome_mkfs" ] || ome_fail "no mke2fs"
command -v sgdisk > /dev/null || ome_fail "no sgdisk"

# 2. source files: the ISO's system.efs is mounted at /sfs and holds a writable system.img
#    (the interactive installer copies the same three files).
[ -b $ome_disk ] || ome_fail "no $ome_disk"
ome_sys=/sfs/system.img
if [ ! -f $ome_sys ]; then
	ome_say "sfs=$(ls /sfs 2>/dev/null | tr '\n' ' ')"
	ome_fail "no /sfs/system.img"
fi
ome_size=$(stat -c %s $ome_sys)
ome_say "source kernel=$(stat -c %s /mnt/kernel) initrd=$(stat -c %s /mnt/initrd.img) system=$ome_size"

# 3. partition: GPT with one Linux partition. No ESP: the installed guest boots the kernel
#    directly from the host (-kernel/-initrd), so no boot loader is written.
ome_say "step partition 5"
sgdisk --zap-all $ome_disk > /dev/null 2>&1 || ome_fail zap
sgdisk --new=1:0:0 --typecode=1:8300 --change-name=1:OME $ome_disk > /dev/null 2>&1 || ome_fail sgdisk
partprobe $ome_disk > /dev/null 2>&1
n=0
until [ -b $ome_part ]; do
	mdev -s
	n=$((n+1))
	[ $n -gt 30 ] && ome_fail "no $ome_part"
	sleep 1
done

# 4. filesystem
ome_say "step format 10"
$ome_mkfs -q -t ext4 -L OME $ome_part > /dev/null 2>&1 || ome_fail mke2fs
mkdir -p /hd
mount -t ext4 -o noatime $ome_part /hd || ome_fail mount
mkdir -p /hd/$ome_dir/data || ome_fail mkdir

# 5. copy kernel, initrd.img and system.img (pv reports whole percentages on stderr)
ome_say "step copy 15"
cp /mnt/kernel /hd/$ome_dir/kernel || ome_fail copy-kernel
cp /mnt/initrd.img /hd/$ome_dir/initrd.img || ome_fail copy-initrd
( pv -n -i 2 $ome_sys > /hd/$ome_dir/system.img ) 2>&1 | while read pct; do
	case "$pct" in
		[0-9]*) ome_say "step copy $((15 + pct * 75 / 100))" ;;
		*) ome_say "pv $pct" ;;
	esac
done
ome_copied=$(stat -c %s /hd/$ome_dir/system.img)
[ "$ome_copied" = "$ome_size" ] || ome_fail "copy-system $ome_copied of $ome_size"

ome_adb_keys

# 6. finish
ome_say "step finish 92"
chown 0:0 /hd/$ome_dir /hd/$ome_dir/* || ome_fail chown
chmod 644 /hd/$ome_dir/kernel /hd/$ome_dir/initrd.img /hd/$ome_dir/system.img || ome_fail chmod
echo "installed=$(date -u +%Y-%m-%dT%H:%M:%SZ) src=$ome_dir" > /hd/$ome_dir/ome-install.txt
sync
umount /hd || ome_fail umount
sync
ome_say "df $(df -k $ome_part 2>/dev/null | tail -1)"
ome_say "done"
ome_off
exit 0
fi

# aaropa tools and source image
ome_say "step tools 1"
mkdir -p /install && mount -t squashfs -o loop,ro /mnt/$SRC/install.sfs /install || ome_fail tools
mkdir -p /install/dev /install/proc /install/sys || ome_fail tools-dirs
mount --bind /dev /install/dev || ome_fail tools-dev
mount --bind /proc /install/proc || ome_fail tools-proc
mount --bind /sys /install/sys || ome_fail tools-sys
ome_tool()
{
	chroot /install "$@"
}
[ -x /install/usr/sbin/sgdisk ] || ome_fail "no sgdisk"
[ -x /install/usr/sbin/mke2fs ] || ome_fail "no mke2fs"
mkdir -p /sfs && mount -t erofs -o loop,ro /mnt/$SRC/system.efs /sfs || ome_fail system-efs
ome_sys=/sfs/system.img
[ -f $ome_sys ] || ome_fail "no /sfs/system.img"
[ -b $ome_disk ] || ome_fail "no $ome_disk"
ome_size=$(stat -c %s $ome_sys)
ome_say "tools sgdisk=/usr/sbin/sgdisk pv= mke2fs=/usr/sbin/mke2fs mkfs.ext3= mkfs.ext4= rsync="
ome_say "source kernel=$(stat -c %s /mnt/$SRC/kernel) initrd=$(stat -c %s /mnt/$SRC/initrd.img) system=$ome_size"

# aaropa partition
ome_say "step partition 5"
ome_tool /usr/sbin/sgdisk --zap-all $ome_disk > /dev/null 2>&1 || ome_fail zap
ome_tool /usr/sbin/sgdisk --new=1:0:0 --typecode=1:8300 --change-name=1:OME $ome_disk > /dev/null 2>&1 || ome_fail sgdisk
partprobe $ome_disk > /dev/null 2>&1
n=0
until [ -b $ome_part ]; do
	mdev -s
	n=$((n+1))
	[ $n -gt 30 ] && ome_fail "no $ome_part"
	sleep 1
done

# aaropa filesystem
ome_say "step format 10"
ome_tool /usr/sbin/mke2fs -q -t ext4 -L OME $ome_part > /dev/null 2>&1 || ome_fail mke2fs
mkdir -p /hd
mount -t ext4 -o noatime $ome_part /hd || ome_fail mount
mkdir -p /hd/$ome_dir/data || ome_fail mkdir

# aaropa copy without pv
ome_say "step copy 15"
cp /mnt/$SRC/kernel /hd/$ome_dir/kernel || ome_fail copy-kernel
cp /mnt/$SRC/initrd.img /hd/$ome_dir/initrd.img || ome_fail copy-initrd
cat "$ome_sys" > /hd/$ome_dir/system.img &
ome_copy_pid=$!
ome_last_pct=-1
while kill -0 $ome_copy_pid 2>/dev/null; do
	ome_copied=$(stat -c %s /hd/$ome_dir/system.img 2>/dev/null || echo 0)
	pct=$((ome_copied * 100 / ome_size))
	[ $pct -gt 100 ] && pct=100
	ome_progress=$((15 + pct * 75 / 100))
	if [ "$ome_progress" != "$ome_last_pct" ]; then
		ome_say "step copy $ome_progress"
		ome_last_pct=$ome_progress
	fi
	sleep 2
done
wait $ome_copy_pid || ome_fail copy-system
ome_copied=$(stat -c %s /hd/$ome_dir/system.img)
[ "$ome_copied" = "$ome_size" ] || ome_fail "copy-system $ome_copied of $ome_size"

ome_adb_keys

# aaropa finish
ome_say "step finish 92"
chown 0:0 /hd/$ome_dir /hd/$ome_dir/* || ome_fail chown
chmod 644 /hd/$ome_dir/kernel /hd/$ome_dir/initrd.img /hd/$ome_dir/system.img || ome_fail chmod
echo "installed=1 src=$ome_dir env=aaropa" > /hd/$ome_dir/ome-install.txt
sync
umount /hd || ome_fail umount
sync
ome_say "df $(df -k $ome_part 2>/dev/null | tail -1)"
ome_say "done"
ome_off
exit 0
