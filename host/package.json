  "type": "module",
  "license": "GPL-2.0-or-later",
  "engines": {
    "node": ">=24.1.0 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:qa": "tsc -b && vite build --mode qa",
